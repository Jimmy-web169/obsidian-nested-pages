{
  "name": "nested-pages",
  "version": "0.1.0",
  "description": "Notion-style page tree sidebar for Obsidian — merges note + same-name folder into a single expandable page",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": ["obsidian", "plugin", "notion", "tree", "sidebar"],
  "author": "Jimmy-web169",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.20.0",
    "obsidian": "latest",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3"
  }
}
